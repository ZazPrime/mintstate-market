# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: only needed for privileged server-side operations
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection used by migrations and ingestion workers
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# eBay Browse / Marketplace Insights OAuth client
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
# EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_CONCURRENCY=3

# JustTCG (singles + sealed market prices)
JUSTTCG_API_KEY=

# tcgapi.dev (sealed product catalogue + market prices)
TCGAPI_KEY=
