# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Newer Supabase projects call this the publishable key; either name works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: only needed for privileged server-side operations
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection used by migrations and ingestion workers
DATABASE_URL=postgresql://postgres:password@host:5432/postgres


# PokemonPriceTracker v2 — singles (raw + PSA graded comps) and sealed products
POKEMON_PRICE_TRACKER_API_KEY=
